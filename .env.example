# ============================================================
# World Associates Shipping CO - environment configuration
# Copy this file to `.env` and fill in the values.
# ============================================================

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the app then runs on an
# embedded PostgreSQL (PGlite) stored in PGLITE_DATA_DIR and everything works
# with zero external services.
# For production (Supabase / any PostgreSQL) set the connection string here.
DATABASE_URL=""
PGLITE_DATA_DIR=".data"

# --- Sessions ---------------------------------------------------------------
# Random, long, unguessable string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret-before-deploying"
SESSION_COOKIE_NAME="wa_session"
SESSION_TTL_DAYS="30"

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Riyadh"

# --- File uploads -----------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES="5242880"

# --- Payments ---------------------------------------------------------------
# No gateway is pre-configured. Set PAYMENT_GATEWAY_ENABLED=true only after a
# Saudi payment gateway (Hyperpay / Moyasar / Tap / PayTabs ...) is contracted
# and its credentials are filled in. Card numbers and CVV are never stored.
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_GATEWAY_NAME=""
PAYMENT_GATEWAY_PUBLIC_KEY=""
PAYMENT_GATEWAY_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- Staff bootstrap (development only) -------------------------------------
# Used by `npm run db:seed` to create the first super administrator.
BOOTSTRAP_ADMIN_EMAIL="admin@worldassociates.example"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe!12345"
BOOTSTRAP_ADMIN_NAME="مدير النظام"
