# ============================================================
# World Associates Shipping CO - environment configuration
# Copy this file to `.env` and fill in the values.
#
# This application is Supabase-native: Supabase Auth is the identity
# provider and the PostgreSQL database is the Supabase project. Row Level
# Security (supabase/migrations/0003_rls.sql) is the data-security boundary,
# so the app talks to Supabase with the *publishable* (anon) key only. The
# service-role / secret key is NEVER used here and must never reach client
# code. Copy this file: `cp .env.example .env`
# ============================================================

# --- Supabase (REQUIRED) ----------------------------------------------------
# Dashboard -> Project Settings -> General -> "Project URL".
NEXT_PUBLIC_SUPABASE_URL=""

# Dashboard -> Project Settings -> API -> "Publishable" (anon) key.
# This is the client-side key; it is safe to expose and is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# The service-role (secret) key is intentionally NOT used by the app. It is only
# needed by the Supabase SQL Editor / CLI when applying SQL scripts, and must
# never be committed or shipped to the browser. Leave blank here.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Application ------------------------------------------------------------
# Public origin of this deployment (used for auth email / recovery links).
# Local dev default: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Display timezone for all dates shown in the UI.
APP_TIMEZONE="Asia/Riyadh"

# --- Payments (optional) ----------------------------------------------------
# No gateway is pre-configured. Set PAYMENT_GATEWAY_ENABLED=true only after a
# Saudi payment gateway (Hyperpay / Moyasar / Tap / PayTabs ...) is contracted
# and its credentials are filled in. Card numbers and CVV are never stored.
PAYMENT_GATEWAY_ENABLED="false"
PAYMENT_GATEWAY_NAME=""
PAYMENT_GATEWAY_PUBLIC_KEY=""
PAYMENT_GATEWAY_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
