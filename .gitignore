/uploads

# environment (secrets) — only .env.example is committed
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo
.vercel

# debug
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tests / tooling
/coverage
